{
  "name": "watch-everywhere",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "watchEverywhere - 基于规则的多源聚合阅读 / 观看工具（参考 any-reader 实现）",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm run dev -w @watch-everywhere/server\" \"npm run dev -w @watch-everywhere/web\"",
    "dev:server": "npm run dev -w @watch-everywhere/server",
    "dev:web": "npm run dev -w @watch-everywhere/web",
    "build": "npm run build -w @watch-everywhere/web",
    "start": "npm run start -w @watch-everywhere/server",
    "postinstall": "node scripts/setup-iptv.mjs",
    "iptv:update": "node scripts/setup-iptv.mjs --update",
    "test": "npm run test -w @watch-everywhere/core && npm run test -w @watch-everywhere/server",
    "typecheck": "tsc --noEmit -p packages/server/tsconfig.json && vue-tsc --noEmit -p packages/web/tsconfig.json",
    "lint": "eslint ."
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.12.0",
    "typescript-eslint": "^8.72.1",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": ">=18"
  }
}
